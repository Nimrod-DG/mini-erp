# Copy to frontend/.env.production and fill in the Cloud Run URL.
#
# `npm run build` runs in production mode, and Vite loads .env.production on top
# of .env.local — so this file is what decides which API the deployed bundle
# talks to, and your local .env.local does not leak into a release.
#
# THE ORDER IS FORCED: VITE_API_BASE_URL is baked into the bundle at build time,
# so the backend must be deployed and its URL read off BEFORE the frontend is
# built. A frontend built first points at localhost:8080 and fails every request
# in a way that looks like a CORS problem.
#
# These are public identifiers, not secrets — they ship inside the JS bundle by
# design (§2.4.4). The Firebase project stays the dev one: the deployed app
# authenticates the same seeded demo accounts. See docs/DEPLOY.md.

VITE_FIREBASE_API_KEY=AIzaSyDixUw_ch3oJeBaHOiZTbMEmWrwoaq3TmM
VITE_FIREBASE_AUTH_DOMAIN=erp-project-b66ce.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=erp-project-b66ce
VITE_FIREBASE_APP_ID=1:889259985673:web:1bd9b28a7769be3142e1d8

# No trailing slash. lib/api.ts concatenates paths onto this directly.
VITE_API_BASE_URL=https://mini-erp-api-XXXXXXXXX.asia-southeast1.run.app
