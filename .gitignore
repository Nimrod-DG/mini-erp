# --- credentials: these lines exist before the files they protect ------------
secrets/
*-service-account.json
# Firebase names the downloaded key <project>-firebase-adminsdk-<hash>.json,
# which the pattern above does not match. It lands in your Downloads folder and
# gets dragged to the repo root, so match it by shape wherever it appears.
*firebase-adminsdk*
*serviceAccountKey*.json
*.local
.env
.env.*
!.env.example
# The Phase 9 deployment templates. Same rule as .env.example: same keys,
# no credentials. frontend/.env.production itself stays ignored by the line
# above, because it names a deployment rather than describing one.
!.env.production.example
# A filled-in copy of deploy/neon-bootstrap.sql holds three real passwords.
deploy/*.filled.sql
# deploy/prod.env holds the two production connection strings. The committed
# deploy/cloudrun.env.yaml is the one with nothing secret in it.
deploy/*.env

# --- go ----------------------------------------------------------------------
/backend/bin/
/backend/tmp/
*.exe
*.test
*.out

# --- node --------------------------------------------------------------------
node_modules/
# The Firebase CLI's per-deploy upload cache. Machine-local build state.
.firebase/
/frontend/dist/
/frontend/.vite/
npm-debug.log*
# Vitest's coverage output. The Go side's coverage.out is already covered by
# *.out above; this is the same artefact for the other application.
/frontend/coverage/

# --- editors / os ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
